.{
    .name = .raylibz,
    // raylib is at 6.1-dev (raylib.h's RAYLIB_VERSION), so raylibz is too. This
    // is package metadata only; Live at Head means nothing is tagged.
    .version = "6.1.0-dev",
    // The Zig++ release this package is built and tested with. Zig++'s version
    // dispatch runs exactly this compiler inside this tree.
    .minimum_zig_version = "0.17.0-dev.2480+zigpp.e95c60250",

    .fingerprint = 0x1c692ef423502e, // Changing this has security and trust implications.

    // raylib's C sources, its own build.zig (ported to Zig++'s build API) and
    // the translated modules it publishes. Pinned by commit: there are no tags.
    .dependencies = .{
        .raylib = .{
            .url = "https://github.com/mattneel/raylib/archive/64d8418c9becf5f22074da8802c83dd50b8cd294.tar.gz",
            .hash = "raylib-6.0.0-whq8uOFdNAV25mtvG8ZoFyRQNRs4HM9eUh2PuwJTc1GV",
        },
    },

    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "examples",
        "tools",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "NOTICE",
    },
}
